# Postgres connection string (Vercel adds this when you attach a Neon database)
DATABASE_URL=
# Long random string used to sign login cookies and encrypt stored AI keys
APP_SECRET=
# Passcode for the /admin page
ADMIN_PASSCODE=
# OpenRouter Management key: can only create and adjust keys, cannot spend
OPENROUTER_MANAGEMENT_KEY=
# OpenRouter regular key with a small cap, used only as a shared backup
OPENROUTER_API_KEY=
# Set to 1 to use a built-in fake AI (local development and tests only)
AI_MOCK=
